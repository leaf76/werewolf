{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "werewolf",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Worker first so every HTML/JSON response can get security headers.
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },
  "kv_namespaces": [
    {
      "binding": "ROOM_INDEX",
      "id": "0cc4a74c3814464b9990b3fd8b594b8c",
      "preview_id": "102f668d2cb94fb59dabe7ac1c1ec320"
    }
  ],
  "ratelimits": [
    {
      "name": "CREATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "observability": { "enabled": true }
}
